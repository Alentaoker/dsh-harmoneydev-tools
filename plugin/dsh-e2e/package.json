{
  "name": "dsh-e2e",
  "version": "0.5.0-rc.2",
  "private": true,
  "type": "module",
  "description": "dshVerify（鸿蒙开发验证）— 开发任务、安装交接、验证轮次、追加事件与证据服务；设备执行与观察由 dshHarmony 完成。安装标识仍为 dsh-e2e",
  "license": "Apache-2.0",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./agent": "./lib/agent.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "7z-bin": "26.4.0",
    "js-yaml": "4.1.1",
    "sharp": "0.35.5",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
