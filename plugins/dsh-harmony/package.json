{
  "name": "dsh-harmony",
  "version": "0.5.0-rc.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "description": "dshHarmony — 鸿蒙设备控制、投屏、截图录像、文件、应用、日志、数据库与测试工作台",
  "exports": {
    ".": "./lib/index.js",
    "./agent": "./lib/agent.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    ".harmony-worker",
    "third_party",
    "cordis.patch.yml",
    "README.md",
    "LICENSE-Piora",
    "UPSTREAM.json",
    "patches",
    "resources"
  ],
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/build.mjs",
    "import:video": "node scripts/import-native-video.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@deveco/deveco-cli": "1.3.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@sinclair/typebox": "0.34.41",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "diff": "^8.0.4",
    "hypium-driver": "6.1.210",
    "iconv-lite": "0.6.3",
    "json5": "^2.2.3",
    "jszip": "^3.10.1",
    "mediabunny": "1.60.0",
    "proper-lockfile": "4.1.2",
    "sharp": "0.35.5",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
